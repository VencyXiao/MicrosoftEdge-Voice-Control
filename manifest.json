{
  "manifest_version": 3,
  "name": "Voice Page Controller",
  "version": "0.1.0",
  "description": "语音控制浏览器页面：清理广告、搜索、滚动、打开页面",
  "permissions": [
    "storage",
    "scripting",
    "tabs",
    "activeTab"
  ],
  "host_permissions": [
    "https://ark.cn-beijing.volces.com/*",
    "https://dashscope.aliyuncs.com/*",
    "https://api.deepseek.com/*",
    "http://127.0.0.1/*",
    "http://localhost/*",
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "语音控制"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content/content.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["<all_urls>"],
      "exclude_matches": ["http://127.0.0.1/*", "http://localhost/*"],
      "js": ["content/floating.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["http://127.0.0.1/*", "http://localhost/*"],
      "js": ["content/host_bridge.js"],
      "run_at": "document_start"
    }
  ]
}
